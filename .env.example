# --- Bulb --------------------------------------------------------------------
# BULB_IP=192.168.1.50   # optional; the UI asks for this if unset
# This machine's LAN IP. Leave empty to let the library discover it.
# HOST_IP=192.168.3.155

# --- Cortex ------------------------------------------------------------------
# Cortex credentials are NOT read from here — type them into Settings inside
# the app. They are stored in ~/.emotiv_brain_light/settings.json.
# HEADSET_ID=

# --- Mapping -----------------------------------------------------------------
# adaptive = z-score against your own baseline (recommended)
# raw      = compare the raw 0..1 values against each other
SCORE_MODE=adaptive
BASELINE_HALFLIFE=60
SWITCH_MARGIN=0.06
SWITCH_HOLD=0.8
IGNORE_METRICS=lex

# --- Render ------------------------------------------------------------------
RENDER_FPS=25
SMOOTH_TAU=0.45
# Backoff ceiling when the bulb stops answering (seconds).
RECONNECT_MAX_DELAY=60
BRIGHT_MIN=12
BRIGHT_MAX=100
SAT_MIN=55
SAT_MAX=100
VERBOSE=true
